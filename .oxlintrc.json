{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
// The access control code of scripts/architecture/** is handwritten .mjs, without type checking.
// Only no-undef is enabled here (full position opening will flood the stock warning), the purpose is to make
// "Referencing a non-existent function" will explode in the lint stage, instead of waiting until the access control is run and a ReferenceError will occur.
      "files": ["scripts/architecture/**/*.mjs"],
// These .mjs run in Node: process / console / URL are legal globals, if not declared
// no-undef will report them all as undefined, and the rules will become noise instead of signal.
      "env": { "node": true },
      "rules": { "no-undef": "error" }
    },
    {
// Test files naturally stack a large number of scenarios and assertions, and continuing to reuse the upper limit of lines of production code will cause false positives.
// Therefore, max-lines is only turned off for the test/spec file to avoid relaxing business code constraints.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
// The test for architecture access control is also .mjs. If it is not exempted, the 400-line limit will force people to delete assertions.
        "**/*.test.mjs",
        "**/*.spec.mjs"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "docs/electron"
  ]
}
