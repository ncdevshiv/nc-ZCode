{
    "name":  "zcode",
    "version":  "3.14.0",
    "private":  true,
    "license":  "Apache-2.0",
    "type":  "module",
    "workspaces":  [
                       "packages/*",
                       "apps/zcode-cli",
                       "apps/zcode-cli/packages/*",
                       "apps/zcode-cli/tools/*"
                   ],
    "scripts":  {
                    "dev:web":  "concurrently -k -n server,web -c blue,green \"bun run --filter @zcode/server dev\" \"bun run --filter @zcode/web dev\"",
                    "dev:desktop":  "bun run dev:tauri",
                    "dev:desktop:test":  "bun scripts/dev-desktop-env.mjs test",
                    "dev:desktop:prod":  "bun scripts/dev-desktop-env.mjs production",
                    "dev:desktop:bytecode":  "bun scripts/dev-desktop-env.mjs production --agent-bytecode",
                    "dev:desktop:remote-prod":  "bun scripts/dev-desktop-remote-prod.mjs",
                    "dev:server":  "bun run --filter @zcode/server dev",
                    "dev:tauri":  "bun run --filter @zcode/web build \u0026\u0026 cargo run --manifest-path native/Cargo.toml -p nc-code-shell",
                    "build:tauri":  "bun run --filter @zcode/web build \u0026\u0026 cargo build --release --manifest-path native/Cargo.toml -p nc-code-shell",
                    "prepare":  "bunx husky",
                    "prepare:desktop-runtime":  "bun run --filter @zcode/desktop prepare:runtime-assets",
                    "dep:graph":  "bun scripts/dependency-graph.mjs",
                    "dep:refs":  "bun scripts/dep-refs.mjs",
                    "golden:vectors":  "bun scripts/gen-v4-golden-vectors.ts",
                    "golden:check":  "bun scripts/gen-v4-golden-vectors.ts --check",
                    "native:test":  "cargo test --manifest-path native/Cargo.toml",
                    "verify:pre-push":  "bun run lint \u0026\u0026 bun run architecture:test \u0026\u0026 bun run architecture:check -- --changed",
                    "build":  "bun run --workspaces build",
                    "build:desktop-agent:bytecode":  "bun scripts/build-desktop-agent-bytecode.mjs",
                    "build:zcode":  "bun scripts/build-zcode.mjs",
                    "build:bootstrap":  "bun run --filter \u0027./packages/*\u0027 --filter \u0027!@zcode/desktop\u0027 build \u0026\u0026 bun run --filter @zcode/desktop build:no-runtime-assets",
                    "build:sea":  "bun --cwd=apps/zcode-cli run build:sea",
                    "build:bun":  "bun --cwd=apps/zcode-cli run build:bun",
                    "build:sea:all":  "bun install \u0026\u0026 bun --cwd=apps/zcode-cli run build:sea",
                    "build:native-search":  "bun scripts/build-native-search-tools.mjs",
                    "pack:native-search":  "bun scripts/package-native-search-tools.mjs",
                    "clean":  "bun scripts/clean.mjs",
                    "typecheck":  "bunx tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/zcode-server-cli packages/ui packages/web packages/desktop/tsconfig.host.json",
                    "bundle:desktop":  "bun run --filter @zcode/desktop run bundle --",
                    "fmt":  "oxfmt",
                    "fmt:check":  "oxfmt --check",
                    "knip":  "bunx knip",
                    "count-lines":  "bash scripts/count-lines.sh",
                    "prepare:remote-assets":  "bun run --filter @zcode/desktop prepare:remote-assets",
                    "doctor:macos-release":  "bash scripts/doctor-macos-release-app.sh",
                    "lint":  "oxlint",
                    "lint:fix":  "oxlint --fix --fix-suggestions",
                    "bootstrap":  "bun scripts/bootstrap.mjs",
                    "bootstrap:with-remote":  "bun scripts/bootstrap.mjs --with-remote",
                    "release":  "bunx release-it",
                    "release:cli":  "bun --cwd=apps/zcode-cli run release",
                    "release:cli:dry":  "bun --cwd=apps/zcode-cli run release:dry",
                    "architecture:check":  "bun scripts/architecture/architecture-check.mjs check",
                    "architecture:report":  "bun scripts/architecture/architecture-check.mjs report",
                    "architecture:baseline:update":  "bun scripts/architecture/architecture-check.mjs baseline:update",
                    "architecture:ts-baseline:update":  "bun scripts/architecture/architecture-check.mjs ts-baseline:update",
                    "architecture:test":  "bun test scripts/architecture/language-boundary.test.mjs",
                    "architecture:context":  "bun scripts/architecture/architecture-check.mjs context"
                },
    "dependencies":  {
                         "border-beam":  "^1.0.1",
                         "d3-path":  "^3.1.0",
                         "tailwind-scrollbar-hide":  "^4.0.0"
                     },
    "devDependencies":  {
                            "@release-it/conventional-changelog":  "^10.0.6",
                            "@tanstack/react-virtual":  "^3.13.23",
                            "@types/node":  "^25.5.0",
                            "concurrently":  "^9.1.2",
                            "conventional-changelog-conventionalcommits":  "^9.3.1",
                            "conventional-changelog-writer":  "^8.4.0",
                            "dotenv":  "^17.4.2",
                            "husky":  "^9.1.7",
                            "istanbul-lib-instrument":  "6.0.3",
                            "knip":  "^6.0.6",
                            "lint-staged":  "^17.0.8",
                            "oxfmt":  "^0.41.0",
                            "oxlint":  "^1.57.0",
                            "postject":  "1.0.0-alpha.6",
                            "release-it":  "^19.2.4",
                            "ts-morph":  "^28.0.0",
                            "tsx":  "^4.19.4",
                            "typescript":  "^6.0.2"
                        },
    "peerDependencies":  {
                             "@tanstack/react-virtual":  "^3.13.23"
                         },
    "engines":  {
                    "bun":  "\u003e=1.4.3",
                    "node":  "\u003e=24.0.0"
                },
    "packageManager":  "bun@1.4.3",
    "overrides":  {
                      "react":  "19.2.7",
                      "react-dom":  "19.2.7"
                  },
    "patchedDependencies":  {
                                "@arms/rum-electron@0.0.3":  "patches/@arms__rum-electron@0.0.3.patch",
                                "@ai-sdk/openai-compatible@2.0.60":  "patches/@ai-sdk__openai-compatible@2.0.60.patch",
                                "@ai-sdk/anthropic@3.0.81":  "patches/@ai-sdk__anthropic@3.0.81.patch"
                            },
    "trustedDependencies":  [
                                "cpu-features",
                                "edgedriver",
                                "electron",
                                "electron-winstaller",
                                "esbuild",
                                "geckodriver",
                                "koffi",
                                "msw",
                                "node-pty",
                                "protobufjs",
                                "ssh2"
                            ]
}
