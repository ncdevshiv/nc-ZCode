# ZCode cloud services removed - fully open source, model/provider agnostic
# All ZCode service URLs have been removed. Configure providers directly via API keys.

# BIGMODEL_API_BASE_URL=https://bigmodel.cn
# ZAI_OAUTH_CLIENT_ID removed (OAuth disabled)

# 可选本地 Provider 配置文件路径；留空使用内置配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
