{
  "name": "zcode-cli",
  "version": "0.16.9",
  "private": true,
  "description": "A cross-platform TypeScript Node.js CLI with a small TUI and optional SEA packaging.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/run-workspace-script.mjs build",
    "build:bun": "bun run --filter @zcode/cli build:bun",
    "build:sea": "bun run --filter @zcode/cli build:sea",
    "check": "bun run registry:check && bun run typecheck",
    "clean": "bun scripts/run-workspace-script.mjs clean",
    "cli:build": "bun run --filter @zcode/cli build",
    "cli:dev": "bun run --filter @zcode/cli dev",
    "cli:upload-sea": "bun run --filter @zcode/cli upload:sea",
    "dev": "bun run --filter @zcode/cli dev",
    "format": "oxfmt --write package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "format:check": "oxfmt --check package.json \"packages/**/*.json\" \"packages/**/*.ts\" \"packages/**/*.mjs\"",
    "lint": "bun scripts/run-workspace-script.mjs lint",
    "lint:count": "bun scripts/count-ts-lines.mjs",
    "lint:fix": "bun scripts/run-workspace-script.mjs lint:fix",
    "prompt-trajectory:model-io": "bun run --filter @zcode/prompt-trajectory model-io --",
    "prompt-trajectory:prompt": "bun run --filter @zcode/prompt-trajectory record:prompt --",
    "registry:check": "bun scripts/generate-bash-command-registry.mjs --check",
    "registry:generate": "bun scripts/generate-bash-command-registry.mjs",
    "release": "bun ../../node_modules/release-it/bin/release-it.js --config .release-it.json",
    "release:dry": "bun run release --release-version",
    "sea": "bun run --filter @zcode/cli sea",
    "typecheck": "bun scripts/run-workspace-script.mjs typecheck"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "proxy-agent": "^8.0.1"
  },
  "devDependencies": {
    "@withfig/autocomplete": "2.692.3",
    "@types/node": "^24.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.14.0"
  },
  "packageManager": "bun@1.4.3"
}
