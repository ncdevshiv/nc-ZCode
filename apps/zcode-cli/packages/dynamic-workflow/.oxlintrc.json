{
// The oxlint configuration that comes with this package: must exist explicitly, otherwise run `bun run --filter @zcode/dynamic-workflow lint` from the warehouse root
//When the configuration is automatically discovered, the root .oxlintrc.json will be found upwards, and the ignorePatterns of the root configuration contains "apps/zcode-cli",
// Causes 0 files in the entire package to be lintable and fails with exit 1. After recently discovering this document, the rules still pass extends
// Completely inherit the root configuration, only the ignorePatterns below are the differences unique to this package.
  //
// The graphic corpus of the analysis test (top-level return, top-level for-await, bare agent()) is not a legal module syntax.
// Unified exclusion in ignorePatterns - the root `bun run lint` and the two entries of lint in the package share this exemption list.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../../.oxlintrc.json"],
  "ignorePatterns": [
    "tests/workflows/**",
    "tests/graphs/**",
    "tests/holes/**",
    "tests/schemas/**",
    "tests/schema-errors/**"
  ],
// Override is left blank: when the file exceeds the max-lines limit, the module should be disassembled instead of going back here to add an exemption list.
  "overrides": []
}
